{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"tasks": {
		/*
		 * `^build` on every task, including this one: a task's hash covers its own
		 * package plus the hashes of the tasks it depends on, and nothing else.
		 * Without an edge into @ballbot/shared, editing a shared component left
		 * every app task a cache hit — turbo replayed a stale "passed" for code it
		 * had never seen. @ballbot/shared is consumed as source and has no build
		 * step of its own, so its `build` script is a no-op that exists purely to
		 * carry that hash.
		 */
		"sync-public": {
			"dependsOn": ["^build"],
			/*
			 * The whole tree, not the three subpaths it used to name: `public/` is
			 * generated in full (gitignored) and `_headers` sits at its root, so a
			 * narrower list let a cache hit restore a site without its header rules.
			 */
			"outputs": ["public/**"]
		},
		"build": {
			"dependsOn": ["sync-public", "^build"],
			"outputs": [".next/**", "!.next/cache/**", ".open-next/**"]
		},
		"dev": {
			"dependsOn": ["sync-public"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["sync-public", "^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		/*
		 * A root task, not a package one: the slug-parity test reads both markets'
		 * content files, and a package-scoped task would hash only its own package
		 * — replaying a stale "passed" after the *other* market's file changed,
		 * the same trap the note at the top describes. Its inputs are the two files
		 * it reads and itself.
		 */
		"//#check:slugs": {
			"inputs": ["apps/*/src/content/portfolio.ts", "scripts/slugs.test.mjs"]
		},
		"typecheck": {
			"dependsOn": ["sync-public", "^build"]
		},
		"deploy": {
			"dependsOn": ["sync-public", "^build"],
			"cache": false
		},
		/*
		 * The site as a PDF, on the asset bucket (docs/how-to-portfolio-to-pdf).
		 * Neither is ever a cache hit: `pdf` prints whatever the live site — or,
		 * with `--local`, a build it makes itself — serves at that moment, which
		 * no file in the repository hashes, and `pdf:push` writes to R2. No
		 * `dependsOn` either: `pdf --local` runs sync-public and the build on its
		 * own, and `pdf:push` must send the file `pdf` already verified, never
		 * print a fresh one on its way. The root scripts end in `--`, so
		 * `npm run pdf -- --local` hands the flag to both markets' tasks, and
		 * run with `--continue`: by default turbo interrupts every other task
		 * when one fails, which cut the other market's render short, or its
		 * upload between the put and the record of it.
		 */
		"pdf": {
			"cache": false,
			/*
			 * Turborepo's strict environment mode strips TMPDIR as well, and a
			 * task without it takes /tmp for the system's temporary folder. A
			 * render makes its own under that folder for the build, the preview
			 * and Chromium, and SKILL §6-10 looks for what a killed one left in
			 * $TMPDIR: run from the root, it would have been in /tmp, unseen.
			 */
			"passThroughEnv": ["TMPDIR"]
		},
		"pdf:push": {
			"cache": false,
			/*
			 * Turborepo hands a task only the environment it is told about. An
			 * API token in the environment is how wrangler authenticates when it
			 * is not logged in through the browser.
			 */
			"passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
		}
	}
}
