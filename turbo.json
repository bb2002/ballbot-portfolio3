{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"tasks": {
		/*
		 * `^build` on every task, including this one: a task's hash covers its own
		 * package plus the hashes of the tasks it depends on, and nothing else.
		 * Without an edge into @ballbot/shared, editing a shared component left
		 * every app task a cache hit — turbo replayed a stale "passed" for code it
		 * had never seen. @ballbot/shared is consumed as source and has no build
		 * step of its own, so its `build` script is a no-op that exists purely to
		 * carry that hash.
		 */
		"sync-public": {
			"dependsOn": ["^build"],
			/*
			 * The whole tree, not the three subpaths it used to name: `public/` is
			 * generated in full (gitignored) and `favicon.svg` sits at its root, so
			 * a narrower list let a cache hit restore a site with no favicon.
			 */
			"outputs": ["public/**"]
		},
		"build": {
			"dependsOn": ["sync-public", "^build"],
			"outputs": [".next/**", "!.next/cache/**", ".open-next/**"]
		},
		"dev": {
			"dependsOn": ["sync-public"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["sync-public", "^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		/*
		 * A root task, not a package one: the slug-parity test reads both markets'
		 * content files, and a package-scoped task would hash only its own package
		 * — replaying a stale "passed" after the *other* market's file changed,
		 * the same trap the note at the top describes. Its inputs are the two files
		 * it reads and itself.
		 */
		"//#check:slugs": {
			"inputs": ["apps/*/src/content/portfolio.ts", "scripts/slugs.test.mjs"]
		},
		"typecheck": {
			"dependsOn": ["sync-public", "^build"]
		},
		"deploy": {
			"dependsOn": ["sync-public", "^build"],
			"cache": false
		}
	}
}
