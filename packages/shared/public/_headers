# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Pretendard's dynamic subset is content-addressed by slice index and only ever
# replaced wholesale by a version bump, so the slices can be cached forever.
/fonts/*
  Cache-Control: public,max-age=31536000,immutable

# The mock artwork is referenced by a stable path rather than a content hash, so
# it cannot be immutable — but it does not change between deploys either. An
# hour of freshness with a day of stale-while-revalidate keeps a repeat visit
# from re-validating fifteen SVGs before it can paint a card.
/mock/*
  Cache-Control: public,max-age=3600,stale-while-revalidate=86400

# Real brand marks — a product's own app icon, not stand-in art. Same trade as
# the mock tree: a stable path, so freshness rather than immutability.
/brand/*
  Cache-Control: public,max-age=3600,stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
